{
  "name": "ergebnis/attribute-collector",
  "description": "Provides collectors for collecting attributes located on classes, class constants, properties, methods, method parameters, functions, function parameters, and constants.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Andreas Möller",
      "email": "am@localheinz.com",
      "homepage": "https://localheinz.com"
    }
  ],
  "homepage": "https://github.com/ergebnis/attribute-collector",
  "support": {
    "issues": "https://github.com/ergebnis/attribute-collector/issues",
    "source": "https://github.com/ergebnis/attribute-collector",
    "security": "https://github.com/ergebnis/attribute-collector/blob/main/.github/SECURITY.md"
  },
  "require": {
    "php": "~8.0.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "ergebnis/classy": "^3.0.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.50.0",
    "ergebnis/data-provider": "^3.6.0",
    "ergebnis/license": "^2.7.0",
    "ergebnis/php-cs-fixer-config": "^6.59.0",
    "ergebnis/phpstan-rules": "^2.13.1",
    "ergebnis/phpunit-slow-test-detector": "^2.22.1",
    "ergebnis/rector-rules": "^1.9.0",
    "fakerphp/faker": "^1.24.1",
    "infection/infection": "~0.26.16",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1.39",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "phpstan/phpstan-phpunit": "^2.0.12",
    "phpstan/phpstan-strict-rules": "^2.0.8",
    "phpunit/phpunit": "^9.6.33",
    "rector/rector": "^2.3.6",
    "symfony/filesystem": "^5.4.45"
  },
  "autoload": {
    "psr-4": {
      "Ergebnis\\AttributeCollector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ergebnis\\AttributeCollector\\Test\\": "test/"
    },
    "files": [
      "test/Fixture/functions.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "audit": {
      "abandoned": "report"
    },
    "platform": {
      "php": "8.0.30"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
